{
  "manifest_version": 3,
  "name": "OpenPlainEnglish",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Understand health terms where you read. Short, sourced explanations on demand, with a local open dictionary.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenPlainEnglish",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"
  }
}
