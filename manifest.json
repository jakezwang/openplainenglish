{
  "manifest_version": 3,
  "name": "OpenPlainEnglish",
  "version": "0.4.0",
  "minimum_chrome_version": "116",
  "description": "Read health terms in plainer English on the page, compare original words, and restore the original text anytime.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenPlainEnglish",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"
  },
  "commands": {
    "toggle-reading": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Toggle OpenPlainEnglish on this page"
    },
    "restore-original": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Restore original wording on this page"
    }
  }
}
